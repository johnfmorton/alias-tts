APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Sync endpoints need no worker. The async endpoints (POST .../jobs) need a
# running `queue:work` on this connection, or set this to `sync` to degrade async
# to synchronous (short text only). retry_after defaults just above
# TTS_ASYNC_TIMEOUT so a long job is never released/double-run (override with
# DB_QUEUE_RETRY_AFTER).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3 storage — only needed when TTS_STORAGE_DISK=s3 (keeps audio off the app
# server). The IAM identity needs Get/Put/Delete/List on the bucket/prefix.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Dashboard admin (seeded by AdminSeeder, or `php artisan admin:create`)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- TTS service ---
TTS_PROVIDER=replicate
# Where generated audio + voice clips live: "local" (storage/app/private) or "s3"
# (set the AWS_* block above). `speech:cleanup` removes expired audio from either.
TTS_STORAGE_DISK=local
# How long generated audio is kept before `speech:cleanup` deletes it (hours).
# Cleanup runs daily — production needs a cron calling `php artisan schedule:run`.
TTS_TTL_HOURS=720
TTS_DEFAULT_OUTPUT_FORMAT=mp3_44100_128
# Characters per backend call for long text (Chatterbox is short-form)
TTS_CHUNK_CHARS=280
# Merge chunks shorter than this into a neighbor so they're never synthesized
# alone — Chatterbox drops very short inputs (a bare "Why?" or a heading). 0 = off.
TTS_MIN_CHUNK_CHARS=30
# Runs of >= this many spaces mark a block/paragraph boundary (plus blank lines).
# The Bespoken plugin flattens posts and encodes blocks as 4-space runs; raise
# high to rely on newlines only once the client sends proper paragraph breaks.
TTS_BLOCK_SPACE_RUN=4
# Edge-trim each chunk to remove Chatterbox's trailing swoosh/hiss before joining.
# Silence threshold to trim (toward -30dB cuts more tail; risks clipping soft ends)
# and a short fade so seams stay click-free.
TTS_CHUNK_TRIM_THRESHOLD=-40dB
TTS_CHUNK_FADE_MS=8
# Clean silence (ms) inserted at sentence seams and at block/paragraph seams.
TTS_CHUNK_GAP_MS=120
TTS_PARAGRAPH_GAP_MS=400
# Auto-clean reference clips on voice:create (mono, trim silence, loudnorm, peak-limit).
# Disable globally here, or per registration with `voice:create --raw`.
TTS_NORMALIZE_REFERENCE=true
# Replicate backend (Chatterbox). Get a token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
REPLICATE_CHATTERBOX_MODEL=resemble-ai/chatterbox
REPLICATE_CHATTERBOX_VERSION=1b8422bc49635c20d0a84e387ed20879c0dd09254ecdb4e75dc4bec10ff94e97
REPLICATE_TEXT_FIELD=prompt
REPLICATE_REFERENCE_FIELD=audio_prompt
# Resilience to Replicate's burst rate limit (429 + retry_after). Retries honor
# retry_after, else exponential backoff; total wait is capped by TTS_REQUEST_TIMEOUT.
REPLICATE_MAX_RETRIES=5
REPLICATE_RETRY_BASE_MS=1000
REPLICATE_RETRY_MAX_MS=30000
# Min gap (ms) between Replicate prediction calls. 0 = off; ~10000 stays under 6/min.
REPLICATE_MIN_REQUEST_GAP_MS=0
# Async job timeout (seconds) for POST .../jobs generation — the long ceiling the
# async path provides. The job pins this itself, so the worker's --timeout flag is
# optional; the queue's retry_after defaults just above it.
TTS_ASYNC_TIMEOUT=1800
# Max characters accepted by the async jobs endpoint (POST .../jobs), separate from
# the synchronous cap (TTS_MAX_TEXT_LENGTH, default 5000). ~40000 ≈ 6,000–7,000
# words / ~40–50 min of audio. Raise only alongside TTS_ASYNC_TIMEOUT and provider
# throughput — each TTS_CHUNK_CHARS-sized chunk is one sequential provider call.
TTS_MAX_ASYNC_TEXT_LENGTH=40000

VITE_APP_NAME="${APP_NAME}"
