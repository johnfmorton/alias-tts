APP_NAME="Alias TTS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Base GitHub URL; the footer version links to {APP_SOURCE_URL}/releases/tag/v{version}. Set empty to drop the link.
APP_SOURCE_URL=https://github.com/johnfmorton/alias-tts

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Marks the session + CSRF cookies "secure" so the browser only sends them over
# HTTPS. Recommended in production — but ONLY once the site is served over HTTPS
# end to end. If it's on while the app sees the request as plain HTTP, the cookie
# is never stored/sent and login silently loops, so it's left OFF here for local
# and http installs. "End to end" means the ORIGIN terminates TLS: a direct HTTPS
# site qualifies; behind a TLS-terminating proxy (e.g. Cloudflare) it means the
# proxy talks HTTPS to the origin too (Cloudflare "Full (strict)", not "Flexible"),
# or TRUSTED_PROXIES (below) is set so the app trusts the proxy's X-Forwarded-Proto.
# SESSION_SECURE_COOKIE=true

# Behind a reverse proxy / CDN that terminates TLS (Cloudflare, a load balancer,
# nginx)? Set this to trust its X-Forwarded-* headers, so the app sees the real
# visitor IP (used by the per-IP login rate-limiter and logs) and the true https
# scheme instead of the proxy's. "*" trusts any upstream — only safe when the
# origin accepts traffic ONLY from the proxy (firewall it to the proxy's IPs);
# otherwise give a comma-separated list of the proxy's IP ranges. Unset (default)
# trusts nothing, which is correct for a directly-exposed site. Forge's own
# *.on-forge.com domains are trusted automatically without this.
# TRUSTED_PROXIES=*

BROADCAST_CONNECTION=log
# Laravel's default disk — NOT used by this app (every file operation names its
# disk explicitly). Leave this as "local"; to use S3/Backblaze B2, set
# TTS_STORAGE_DISK=s3 below instead (+ the AWS_* block).
FILESYSTEM_DISK=local
# Sync endpoints need no worker. The async endpoints (POST .../jobs) need a
# running `queue:work` on this connection, or set this to `sync` to degrade async
# to synchronous (short text only). retry_after defaults just above
# TTS_ASYNC_TIMEOUT so a long job is never released/double-run (override with
# DB_QUEUE_RETRY_AFTER).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Not used by the app today — nothing sends mail (password recovery is
# admin-mediated via signed links from the Users page; see TTS_SUPPORT_EMAIL
# below). Standard Laravel block kept for the future; leave as-is.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible object storage — only needed when TTS_STORAGE_DISK=s3 (keeps
# audio off the app server). Works with ANY S3-compatible provider: AWS S3,
# Backblaze B2, Cloudflare R2, MinIO, Wasabi, DigitalOcean Spaces, … The names
# are `AWS_*` by Laravel/SDK convention (the S3 protocol), not Amazon-specific.
# The access key needs read/write/delete/list on the bucket (or the prefix).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Leave AWS_ENDPOINT blank for AWS S3. For any other provider, set it to their S3
# endpoint and enable path-style addressing. Backblaze B2 example:
#   AWS_ENDPOINT=https://s3.us-west-001.backblazeb2.com   (region: us-west-001)
#   AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Shown on the sign-in page as the "forgot your password?" contact (opens a
# pre-drafted email). Leave empty to show generic ask-your-admin guidance.
TTS_SUPPORT_EMAIL=

# Dashboard admin login. Set both, then run `php artisan admin:create` (no
# arguments needed — it reads these; anything missing is prompted for).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Single sign-on (optional). Leave blank to keep a provider dormant — its buttons
# read "not configured" and the routes refuse instead of erroring. Two-factor auth
# (TOTP) needs nothing here. Register the callback URL <APP_URL>/oauth/<provider>/callback
# in each provider's console. See docs/SSO-SETUP.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- TTS service ---
# The app only supports "replicate" in the current version of the app.
TTS_PROVIDER=replicate
# Where generated audio + voice clips live: "local" (storage/app/private) or "s3"
# (set the AWS_* block above). `speech:cleanup` removes expired audio from either.
TTS_STORAGE_DISK=local
# Optional subfolder for EVERYTHING this install stores (speech/, voices/,
# avatars/, genblaze/), so several apps can share one bucket or disk. Set it
# before first use, or move existing objects into the subfolder yourself —
# database paths stay relative, so nothing else changes. The Genblaze runner
# reads this too, but from its OWN environment: the run-genblaze.sh wrapper
# (docs/GENBLAZE-SETUP.md) sources it from this file automatically.
TTS_STORAGE_ROOT=
# Public /verify page ("is this the approved final?"). It fingerprints the file
# in the visitor's browser (Web Crypto) and sends only the SHA-256 — nothing is
# uploaded. Set TTS_VERIFY_ALLOW_UPLOAD=true only to add a server-side upload
# fallback for non-secure-context browsers (no crypto.subtle); that fallback
# accepts files up to TTS_VERIFY_MAX_UPLOAD_KB and must stay under the web
# server's client_max_body_size / PHP post_max_size (see `tts:doctor`).
TTS_VERIFY_ALLOW_UPLOAD=false
TTS_VERIFY_MAX_UPLOAD_KB=204800
# How long generated audio is kept before `speech:cleanup` deletes it (hours).
# Cleanup runs daily — production needs a cron calling `php artisan schedule:run`.
TTS_TTL_HOURS=720
# Estimated provider cost per 1,000 input characters (USD) for the Studio
# spend readouts. 0.025 = Replicate's Chatterbox rate. Set to 0 to hide them.
TTS_COST_PER_1K_CHARS=0.025
TTS_DEFAULT_OUTPUT_FORMAT=mp3_44100_128
# Characters per backend call for long text (Chatterbox is short-form)
TTS_CHUNK_CHARS=280
# How sentences group into chunks: 'packed' fills each chunk up to
# TTS_CHUNK_CHARS (default); 'sentence' gives every sentence its own chunk.
# Per-user editable on the Settings page — UNCOMMENTING this pins it
# instance-wide and makes the Settings-page dropdown read-only.
# TTS_CHUNK_MODE=packed
# Merge chunks shorter than this into a neighbor so they're never synthesized
# alone — Chatterbox drops very short inputs (a bare "Why?" or a heading). 0 = off.
TTS_MIN_CHUNK_CHARS=30
# Runs of >= this many spaces mark a block/paragraph boundary (plus blank lines).
# The Bespoken plugin flattens posts and encodes blocks as 4-space runs; raise
# high to rely on newlines only once the client sends proper paragraph breaks.
TTS_BLOCK_SPACE_RUN=4
# Edge-trim each chunk to remove Chatterbox's trailing swoosh/hiss before joining.
# Silence threshold to trim (toward -30dB cuts more tail; risks clipping soft ends)
# and a short fade so seams stay click-free.
TTS_CHUNK_TRIM_THRESHOLD=-40dB
TTS_CHUNK_FADE_MS=8
# Clean silence (ms) inserted at sentence seams and at block/paragraph seams.
TTS_CHUNK_GAP_MS=120
TTS_PARAGRAPH_GAP_MS=400
# Studio → Projects tab page size (the tab's count badge still shows the full total).
TTS_STUDIO_PROJECTS_PER_PAGE=10
# Auto-clean reference clips on voice:create (mono, trim silence, loudnorm, peak-limit).
# Disable globally here, or per registration with `voice:create --raw`.
TTS_NORMALIZE_REFERENCE=true
# Replicate backend (Chatterbox). Get a token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
REPLICATE_CHATTERBOX_MODEL=resemble-ai/chatterbox
REPLICATE_CHATTERBOX_VERSION=1b8422bc49635c20d0a84e387ed20879c0dd09254ecdb4e75dc4bec10ff94e97
REPLICATE_TEXT_FIELD=prompt
REPLICATE_REFERENCE_FIELD=audio_prompt
# Resilience to Replicate's burst rate limit (429 + retry_after). Retries honor
# retry_after, else exponential backoff; total wait is capped by TTS_REQUEST_TIMEOUT.
REPLICATE_MAX_RETRIES=5
REPLICATE_RETRY_BASE_MS=1000
REPLICATE_RETRY_MAX_MS=30000
# Min gap (ms) between Replicate prediction calls. 0 = off; ~10000 stays under 6/min.
REPLICATE_MIN_REQUEST_GAP_MS=0

# Reference-clip cleanup (resemble-enhance via Replicate). Denoise + enhance a
# recorded/uploaded reference clip before it becomes the voice reference. On by
# default; reuses REPLICATE_API_TOKEN (above); degrades safely to the original
# clip on any failure. Set TTS_ENHANCE_ENABLED=false to hide the feature.
TTS_ENHANCE_ENABLED=true
# Backend: replicate | fake (fake = deterministic placeholder for tests/offline).
TTS_ENHANCE_PROVIDER=replicate
# Default state of the opt-out "clean up the clip" checkbox on the voice pages.
TTS_ENHANCE_DEFAULT_ON=true
# Gentler mode: denoise only, skip the enhancer (which can alter timbre).
TTS_ENHANCE_DENOISE_ONLY=false
# Seconds for the whole prediction incl. polling (the model runs ~40s on a T4).
TTS_ENHANCE_TIMEOUT=120
# How long a prepared (previewed-but-unsaved) clip token lives before pruning.
TTS_ENHANCE_CLIP_TTL_HOURS=24
# Max clip length (s) the prepare endpoint accepts — bounds the Replicate payload.
TTS_ENHANCE_MAX_CLIP_SECONDS=120
# Model version. A known-good version is pinned in config/tts.php (this model 404s
# on the version-less endpoint), so leave this blank unless bumping it. Blank here
# uses the pinned default; setting it to an empty override would make tts:doctor
# WARN. Confirm at https://replicate.com/resemble-ai/resemble-enhance/api
TTS_ENHANCE_REPLICATE_VERSION=
# Async job timeout (seconds) for POST .../jobs generation — the long ceiling the
# async path provides. The job pins this itself, so the worker's --timeout flag is
# optional; the queue's retry_after defaults just above it.
TTS_ASYNC_TIMEOUT=1800
# Max characters accepted by the async jobs endpoint (POST .../jobs), separate from
# the synchronous cap (TTS_MAX_TEXT_LENGTH, default 5000). ~40000 ≈ 6,000–7,000
# words / ~40–50 min of audio. Raise only alongside TTS_ASYNC_TIMEOUT and provider
# throughput — each TTS_CHUNK_CHARS-sized chunk is one sequential provider call.
TTS_MAX_ASYNC_TEXT_LENGTH=40000

# Genblaze runner — the orchestrator daemon (docs/GENBLAZE-SETUP.md) that powers
# the pronunciation pre-processor and QA-gated generation. Defaults to where a
# standard install runs it; set it empty only to disable the runner entirely.
TTS_GENBLAZE_RUNNER_URL=http://127.0.0.1:8800
# Judge-facing "Genblaze Demo" nav page — for hackathon judging only; leave off
# in normal use.
TTS_GENBLAZE_DEMO=false

# Pronunciation pre-processor (optional). Inserts a review screen before chunking
# where an LLM suggests ASCII respellings for likely-mispronounced terms
# ("DDEV" => "dee dev"). Off by default; degrades safely if the Genblaze runner
# or LLM is unreachable (continue to chunking, no suggestions).
TTS_PRONUNCIATION_ENABLED=false
# Detection LLM provider: replicate | gemini | openai | anthropic. Setting this here locks the
# Settings-page dropdown to a read-only display value. "replicate" reuses
# REPLICATE_API_TOKEN (above), wrapped as a Genblaze chat provider in the runner.
TTS_PRONUNCIATION_LLM_PROVIDER=replicate
# Optional model override (blank = the provider's default).
TTS_PRONUNCIATION_MODEL=
TTS_PRONUNCIATION_TEMPERATURE=0.2
TTS_PRONUNCIATION_TIMEOUT=60
# LLM API keys — consumed by the Genblaze runner (Python); mirror them into the
# runner's environment. Only the key for the selected provider is required; the
# default "replicate" provider uses REPLICATE_API_TOKEN (above) instead.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

VITE_APP_NAME="${APP_NAME}"
