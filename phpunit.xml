<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- The PixelSmash ffmpeg version gate would otherwise fail the suite
             whenever the test runner's ffmpeg predates 8.1.2; tests don't depend
             on the runner shipping the newest ffmpeg. The gate itself is covered
             by tests/Unit/FfmpegVersionParseTest.php. -->
        <env name="TTS_FFMPEG_MIN_VERSION" value="0"/>
        <!-- Local dev .env points these at the Whisper + Genblaze sidecars; keep the
             test env independent of them so the suite never hits a running sidecar.
             (TTS_ASR_ENABLED must stay UNSET — any value would lock it and break the
             ASR auto-enable tests — so it is simply absent from .env, not pinned here.) -->
        <env name="TTS_ASR_URL" value="http://127.0.0.1:8765"/>
        <!-- NOTE: this can't blank DDEV's real container env var (real env beats
             <env> — Laravel reads $_SERVER first), so tests/TestCase.php also
             pins config('tts.genblaze.runner_url') to '' per test. -->
        <env name="TTS_GENBLAZE_RUNNER_URL" value=""/>
        <!-- Local dev .env may pin the pronunciation pre-processor (provider +
             enabled). Null them here (env() reads "null" as null) so the settings
             tests see the keys as UNLOCKED/editable and the feature defaults off
             unless a test turns it on explicitly. -->
        <env name="TTS_PRONUNCIATION_ENABLED" value="null"/>
        <env name="TTS_PRONUNCIATION_LLM_PROVIDER" value="null"/>
        <!-- Reference-clip cleanup: use the deterministic fake enhancer so the
             suite never calls Replicate. Tests that exercise the degrade-safe
             fallback rebind EnhanceProvider to a failing fake per test. -->
        <env name="TTS_ENHANCE_PROVIDER" value="fake"/>
    </php>
</phpunit>
