# Environment template for the single-image Docker package.
#
# On first boot the entrypoint copies this file to /data/.env (the container's
# persistent .env) and fills in a generated APP_KEY and TTS_INTERNAL_SECRET.
# Anything here can be overridden per container with `docker run -e NAME=value`
# — a real environment variable always wins over this file. Edit /data/.env
# directly for permanent changes, then restart the container.
#
# The full annotated reference for every setting is .env.example in the repo
# (shipped in the image at /var/www/html/.env.example).

APP_NAME="Alias TTS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Set this to the address users will browse to — it drives generated links.
APP_URL=http://localhost:8080

LOG_CHANNEL=stderr
LOG_LEVEL=info

# SQLite on the /data volume. Point DB_* at MySQL/MariaDB instead if you have
# one (DB_CONNECTION=mysql + DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD).
DB_CONNECTION=sqlite
DB_DATABASE=/data/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# Serving over HTTPS end-to-end (SERVER_NAME auto-HTTPS, or a TLS proxy in
# front with TRUSTED_PROXIES set)? Turn this on. See .env.example for the
# fine print — on plain HTTP it makes login loop silently.
# SESSION_SECURE_COOKIE=true
# Behind a reverse proxy that terminates TLS, trust its X-Forwarded-* headers:
# TRUSTED_PROXIES=*

# --- Dashboard admin -----------------------------------------------------------
# Set both (docker run -e ...) and the FIRST boot creates the login for you.
# Later you can always run: docker exec -u app <container> php artisan admin:create
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- TTS service ----------------------------------------------------------------
TTS_PROVIDER=replicate
# Required for real generation — https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Generated audio + voice clips live on the /data volume by default. Set to
# "s3" (+ the AWS_* block, see .env.example) for any S3-compatible provider;
# that also gives the bundled Genblaze runner a provenance archive.
TTS_STORAGE_DISK=local

# --- Bundled sidecars (in-container; leave as-is) --------------------------------
# Whisper transcript QA — scores every generated chunk and re-rolls/trims bad
# takes automatically. The sidecar ships in this image, so it's ON by default;
# set TTS_ASR_ENABLED=false to opt out.
TTS_ASR_ENABLED=true
TTS_ASR_URL=http://127.0.0.1:8765

# Genblaze runner — whole-render orchestration ("Generate via Genblaze") and
# the pronunciation pre-processor. Shares TTS_INTERNAL_SECRET with the app;
# the entrypoint generates that secret on first boot.
TTS_GENBLAZE_RUNNER_URL=http://127.0.0.1:8800
TTS_INTERNAL_SECRET=

# Pronunciation pre-processor (LLM-suggested respellings before chunking).
# Uses REPLICATE_API_TOKEN out of the box; switchable to gemini/openai/anthropic
# (set the matching *_API_KEY — the runner picks it up from this file too).
TTS_PRONUNCIATION_ENABLED=false
